<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
	<head>
	    <meta http-equiv="Content-Type" content="text/html" charset="utf-8" />
	
	    <title>SeleniumRobot</title>
	
		#if ($localResources)
			#parse("reporter/templates/html.head.local.vm")
			<script src="${staticPathPrefix}resources/templates/Chart.min.js"></script>
		#else
			#parse("reporter/templates/html.head.remote.vm")
			<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/1.0.2/Chart.min.js"></script>
		#end
		
		<link rel="stylesheet" type="text/css" href="${staticPathPrefix}resources/templates/seleniumRobot.css">
		<script src="${staticPathPrefix}resources/templates/seleniumRobot.js"></script>
		<style>
			#parse("reporter/templates/fonts.part.vm")
			/* ============================================================
			   Design tokens - identiques a report.test.vm, garder synchronise
			   ============================================================ */
			:root {
				--sr-font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
				--sr-font-mono: ui-monospace, "SF Mono", "Cascadia Code", "Roboto Mono", Consolas, monospace;

				--sr-space-1: 4px;  --sr-space-2: 8px;  --sr-space-3: 12px;
				--sr-space-4: 16px; --sr-space-5: 24px; --sr-space-6: 32px;

				--sr-radius: 0;
				--sr-radius-sm: 0;

				--sr-ink: #0b1220;
				--sr-ink-muted: #5b6472;
				--sr-ink-faint: #8b93a1;
				--sr-border: #e3e6ea;
				--sr-surface: #ffffff;
				--sr-bg: #f5f6f8;

				--sr-navy: #153a4c;
				--sr-navy-ink: #e9fafc;
				--sr-navy-ink-muted: #9fc4d3;
				--sr-navy-border: #29586e;
				--sr-accent: #1daae2;

				--sr-success: #1a7f4b; --sr-success-bg: #e9f7ef;
				--sr-danger:  #c23b34; --sr-danger-bg:  #fbeae9;
				--sr-neutral: #5b6472; --sr-neutral-bg: #eef0f2;
			}
			/* Dark mode desactive volontairement: le rapport doit toujours s'afficher en clair,
			   peu importe le systeme du lecteur. */

			body { font-family: var(--sr-font-sans); background: var(--sr-bg); color: var(--sr-ink); -webkit-font-smoothing: antialiased; }

			/* --- Navbar --- */
			.app-nav {
				background: var(--sr-navy);
				border-bottom: 1px solid var(--sr-navy-border);
				padding: var(--sr-space-3) var(--sr-space-6);
			}
			.app-nav-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--sr-space-4); flex-wrap: wrap; }
			.app-nav-brand { display: flex; align-items: center; gap: var(--sr-space-2); font-size: 14px; font-weight: 600; color: var(--sr-navy-ink); }
			.app-nav-dot { width: 8px; height: 8px; border-radius: 2px; background: var(--sr-accent); flex-shrink: 0; }
			.app-nav-sep, .app-nav-product { color: var(--sr-navy-ink-muted); font-weight: 400; }
			.app-nav-link { color: var(--sr-navy-ink); text-decoration: none; }
			.app-nav-link:hover { text-decoration: underline; }
			.app-nav-team { color: var(--sr-navy-ink); }

			/* --- Carte de statut --- */
			/* AdminLTE force .main-header a max-height:100px + font cursive "Lobster Two" - notre
			   carte a plus de contenu, et doit rester en police normale. Override explicite
			   necessaire, sinon le titre est cache sous la box suivante et le texte s'affiche
			   dans une police cursive illisible. */
			.report-hero {
				height: auto !important;
				min-height: auto !important;
				max-height: none !important;
				line-height: normal !important;
				font-family: var(--sr-font-sans) !important;
				background: var(--sr-surface);
				border: 1px solid var(--sr-border);
				border-left: 4px solid var(--sr-neutral);
				border-radius: var(--sr-radius);
				padding: var(--sr-space-4) var(--sr-space-6);
				margin: var(--sr-space-5) var(--sr-space-6) 0;
			}
			.report-hero * { font-family: var(--sr-font-sans) !important; }
			.report-hero.all-passed { border-left-color: var(--sr-success); }
			.report-hero.has-failed { border-left-color: var(--sr-danger); }
			.report-hero-row { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: var(--sr-space-4); }
			.report-hero-status { display: flex; flex-direction: column; align-items: center; gap: var(--sr-space-3); text-align: center; }
			.report-hero-title { font-size: 18px; font-weight: 700; color: var(--sr-ink); letter-spacing: -0.01em; }
			.report-stat-eyebrow { font-size: 11px; font-weight: 700; color: var(--sr-ink-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--sr-space-2); }
			.report-stat-row { display: flex; align-items: baseline; gap: var(--sr-space-3); }
			.report-stat-number { font-family: var(--sr-font-mono); font-size: 40px; font-weight: 700; line-height: 1; color: var(--sr-ink); letter-spacing: -0.02em; }
			.report-stat-label { font-size: 14px; color: var(--sr-ink-muted); }
			.report-stat-bar { display: flex; height: 6px; width: 300px; margin-top: var(--sr-space-3); overflow: hidden; }
			.report-stat-legend { display: flex; gap: var(--sr-space-5); margin-top: var(--sr-space-2); font-size: 12px; color: var(--sr-ink-muted); }
			.report-stat-legend b { font-family: var(--sr-font-mono); font-weight: 700; }

			/* --- Contenu --- */
			.container-fluid { padding: 0 var(--sr-space-4) var(--sr-space-6); }
			.content-header h1 { font-size: 13px; font-weight: 700; color: var(--sr-ink-muted); text-transform: uppercase; letter-spacing: 0.05em; }

			.box.box-black {
				background: var(--sr-surface);
				border: 1px solid var(--sr-border);
				border-radius: var(--sr-radius);
				box-shadow: none;
			}
			table.table { font-size: 13px; }
			table.table th, table.table td { border-color: var(--sr-border) !important; padding: var(--sr-space-3) var(--sr-space-3) !important; vertical-align: middle; }
			table.table thead th, table.table tfoot th { font-size: 11px; font-weight: 700; color: var(--sr-ink-muted); text-transform: uppercase; letter-spacing: 0.04em; background: var(--sr-bg) !important; }
			table.table tbody tr:hover { background: var(--sr-bg); }
			table.table td { font-family: var(--sr-font-mono); font-variant-numeric: tabular-nums; }
			table.table td:nth-child(2) { font-family: var(--sr-font-sans); }
			.circleSuccess { color: var(--sr-success); }
			.circleFailed  { color: var(--sr-danger); }
			.circleSkipped { color: var(--sr-neutral); }
		</style>
	</head>

	<body>
	#set ($equipe = "")
	#set ($campagne = "")
	#set ($anyFailed = false)
	#set ($heroPassed = 0)
	#set ($heroFailed = 0)
	#set ($heroSkipped = 0)
	#set ($heroTotal = 0)
	#foreach ($testContext in $tests.entrySet())
		#foreach ($testResult in $testContext.value)
			#set ($heroTotal = $heroTotal + 1)
			#if ($testResult.getStatus() == 1)
				#set ($heroPassed = $heroPassed + 1)
			#elseif ($testResult.getStatus() == 2)
				#set ($anyFailed = true)
				#set ($heroFailed = $heroFailed + 1)
			#else
				#set ($heroSkipped = $heroSkipped + 1)
			#end
			#set ($infoMap = $infos.get($testResult))
			#if ($infoMap && $infoMap.get("Equipe"))
				#set ($equipe = $infoMap.get("Equipe"))
			#end
			#if ($infoMap && $infoMap.get("Campagne"))
				#set ($campagne = $infoMap.get("Campagne"))
			#end
		#end
	#end
	#if ($heroTotal > 0)
		#set ($heroPassedPct = $heroPassed * 100 / $heroTotal)
		#set ($heroFailedPct = $heroFailed * 100 / $heroTotal)
		#set ($heroSkippedPct = $heroSkipped * 100 / $heroTotal)
	#else
		#set ($heroPassedPct = 0)
		#set ($heroFailedPct = 0)
		#set ($heroSkippedPct = 0)
	#end
	#if ($anyFailed)
		#set ($heroStatusClass = "has-failed")
	#else
		#set ($heroStatusClass = "all-passed")
	#end
		<nav class="app-nav">
			<div class="app-nav-inner">
				<div class="app-nav-brand">
					<span class="app-nav-dot"></span>
					<a href="https://github.com/bhecquet/seleniumRobot" class="app-nav-link">SeleniumRobot</a>
					<span class="app-nav-sep">/</span> <span class="app-nav-product">Reports</span>
					#if ($equipe != "")
						<span class="app-nav-sep">/</span> <span class="app-nav-team">$equipe</span>
					#end
					#if ($campagne != "")
						<span class="app-nav-sep">/</span> <span class="app-nav-team">$campagne</span>
					#end
				</div>
			</div>
		</nav>
		<div class="wrapper">
			<header class="main-header report-hero $heroStatusClass">
				<div class="report-hero-row">
					<div class="report-hero-status">
						#if ($equipe != "")
							<div class="report-stat-eyebrow">Campagne d'intégration#if ($campagne != "") &#183; $campagne#end &#183; Équipe $equipe</div>
						#else
							<div class="report-stat-eyebrow">Résumé de suite</div>
						#end
						<div class="report-stat-row">
							<span class="report-stat-number">$heroPassed/$heroTotal</span>
							<span class="report-stat-label">tests réussis</span>
						</div>
						<div class="report-stat-bar">
							<div style="width: ${heroPassedPct}%; background: var(--sr-success);"></div>
							<div style="width: ${heroFailedPct}%; background: var(--sr-danger);"></div>
							<div style="width: ${heroSkippedPct}%; background: var(--sr-neutral);"></div>
						</div>
						<div class="report-stat-legend">
							<span><b style="color: var(--sr-success);">$heroPassed</b> réussis</span>
							<span><b style="color: var(--sr-danger);">$heroFailed</b> échecs</span>
							<span><b style="color: var(--sr-neutral);">$heroSkipped</b> ignorés</span>
						</div>
					</div>
				</div>
			</header>
		</div>
		<div class="container-fluid">
			<!-- canvas garde en DOM (cache) pour seleniumRobot.js: ce script du framework fait
			     document.getElementById("pieChart").getContext(...) sans verifier null - le supprimer
			     du DOM ferait planter ce script en erreur console (silencieux pour l'utilisateur mais
			     sale). Camembert juge redondant avec le recap au-dessus (memes 3 categories), donc
			     cache plutot que retire du DOM. -->
			<div class="pieChart" style="display:none"><canvas id="pieChart"></canvas></div>

			<section class="content-header">
				<h1> Integration tests <span>(<a href="seleniumRobot.log" style="font-size: 15px;">full logs</a>)</span></h1>
			</section>
			
			<section class="content">
		      	<div class="row">
		        	<div class="col-xl-12">
		          		<div class="box box-black">
		            		<div class="box-body">
		              			<table class="table">
		                			<thead>
		                				<tr>
		                					<th class="alignleft"> Tests </th>
						                  	<th class="alignleft"> Methods </th>
						                  	<!--
						                  	<th> Passed Steps Count </th>
						                 	<th> Failed Steps Count </th>
						                 	-->
						                 	<th> Steps Count </th>
						                 	<th> Duration </th>
						                 	#foreach ($infoKey in $infoKeys)
						                 		#if ($infoKey != "Equipe")
						                 			<th> $infoKey </th>
						                 		#end
						                 	#end
						                </tr>
					                </thead>
					                <tbody>
					                #set ($totalPassed = 0)
		                			#set ($totalFailed = 0)
		                			#set ($totalSteps = 0)
		                			#set ($testIdx = 0)
					                
				                	#foreach ($testContext in $tests.entrySet())
				                		#foreach ($testResult in $testContext.value)
				                			#set ($testIdx = $testIdx + 1)
				                			#set ($testName = $testNames.get($testResult))
				                			#set ($description = $descriptions.get($testResult))
				                			#**
				                			Compute step state for each test
				                			*#
				                			#set ($passedSteps = 0)
				                			#set ($failedSteps = 0)
				                			#set ($totalTestSteps = 0)
				                			#set ($stepsDuration = 0)
				                			#set ($testDuration = ($testResult.getEndMillis() - $testResult.getStartMillis()) / 1000)
				                			#foreach ($testStep in $steps.get($testResult))
				                				#if ($testStep.getFailed())
				                					#set ($failedSteps = $failedSteps + 1)
				                				#else
				                					#set ($passedSteps = $passedSteps + 1)
				                				#end
				                				#set ($totalTestSteps = $totalTestSteps + 1)
				                				#set ($stepsDuration = $stepsDuration + $testStep.getDuration() / 1000)
				                			#end
				                			#set ($totalPassed = $totalPassed + $passedSteps)
				                			#set ($totalFailed = $totalFailed + $failedSteps)
				                			#set ($totalSteps = $totalSteps + $totalTestSteps)
				                			#if ($description.isEmpty())
				                				#set ($description = "no description available")
				                			#end
				                			
				                			#if ("$!testResult.getAttribute('snapshotComparisonResult')" == "")
				                				#set ($circle = "")
				                			#elseif ($testResult.getAttribute("snapshotComparisonResult") == 1)
				                				#set ($circle = "<i class=""fas fa-circle circleSuccess"" data-toggle=""tooltip"" title=""snapshot comparison successfull""></i>")
				                			#elseif ($testResult.getAttribute("snapshotComparisonResult") == 3)
				                				#set ($circle = "<i class=""fas fa-circle circleSkipped"" data-toggle=""tooltip"" title=""snapshot comparison skipped""></i>")
				                			#else
				                				#set ($circle = "<i class=""fas fa-circle circleFailed"" data-toggle=""tooltip"" title=""snapshot comparison failed""></i>")
				                			#end
				                			
				                			#if ($testResult.getStatus() == 1)
				                				<tr class="testSuccess">
				                				<td>$testContext.key.getName()</td>
				                				<td class="alignleft">$circle<a href='$testResult.getAttribute("methodResultFileName")' info="ok" data-toggle="tooltip" title="$description">$testName</a></td>
				                			#elseif ($testResult.getStatus() == 2)
				                				<tr class="testFailed">
				                				<td>$testContext.key.getName()</td>
				                				<td class="alignleft">$circle<a href='$testResult.getAttribute("methodResultFileName")' info="ko" data-toggle="tooltip" title="$description">$testName</a></td>
				                			#else 
				                				<tr class="testSkipped">
				                				<td>$testContext.key.getName()</td>
				                				<td class="alignleft">$circle<a href='$testResult.getAttribute("methodResultFileName")' info="skipped" data-toggle="tooltip" title="$description">$testName</a></td>
				                			#end 
	
											<!--
					                		<td name="passed-$testIdx">$passedSteps</td>
					                		#if ($failedSteps == 0)
					                  			<td name="failed-$testIdx">$failedSteps</td>
					                  		#else
					                  			<td name="failed-$testIdx" class="failedSteps">$failedSteps</td>
					                  		#end
					                  		-->
					                  		#if ($failedSteps == 0)
					                  			<td name="stepsTotal-$testIdx">$totalTestSteps</td>
					                  		#else
													<td name="stepsTotal-$testIdx">$totalTestSteps<sup>
														<a href="#" data-toggle="tooltip" class="failedStepsTooltip" title="$failedSteps step(s) failed">*</a>
													  </sup>
					                  			</td>
					                  		#end
					                  		<td>$stepsDuration sec.</td>
					                  		
					                  		
				                			#set ($testInfos = $infos.get($testResult))
					                  		#foreach ($infoKey in $infoKeys)
					                  			#if ($infoKey == "Equipe")
					                  				#* deja affiche une seule fois dans le bandeau hero, pas repete par test *#
					                  			#elseif (!$testInfos || !$testInfos.get($infoKey))
					                  				<td class="info"></td>
					                  			#else
						                 			<td class="info">$testInfos.get($infoKey)</td>
						                 		#end
						                 	#end
					                  		</tr>
				                		
				                		#end	
					                #end
					           		</tbody>
					           		<tfoot>
		                				<tr>
						                  	<th class="alignleft"> Total </th>
						                  	<th> </th>
						                  	<!--
						                  	<th name="totalPassed"> $totalPassed </th>
						                 	<th name="totalFailed"> $totalFailed </th>
						                 	-->
						                 	<th name="totalSteps"> $totalSteps </th>
						                 	<th></th>
						                </tr>
					                </tfoot>
					           	</table>
					        </div>
					    </div>
					</div>
				</div>
			</section>
		</div>		
	</body>
</html>