<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="seleniumdemo test suite (doc only)" parallel="none" verbose="1" thread-count="1">
    <parameter name="browser" value="chrome" />
    <parameter name="headless" value="false" />
    <parameter name="seleniumRobotServerUrl" value="http://localhost:8000" />
    <parameter name="seleniumRobotServerActive" value="true" />
    <!-- seleniumRobotServerToken retire d'ici: vient de la variable d'env SELENIUM_ROBOT_SERVER_TOKEN -->
    <parameter name="testRetryCount" value="0" />
    <parameter name="equipe" value="Selenium Demo" />
    <parameter name="customReport" value="true" />
    <listeners>
        <listener class-name="com.example.seleniumdemo.custom.reporting.CustomReportListener" />
        <listener class-name="com.example.seleniumdemo.custom.reporting.TeamInfoListener" />
    </listeners>
    <test name="Documentation">
        <parameter name="catalogueFields" value="code,name,method,description,class,variables" />
        <parameter name="catalogueLayout" value="matrix" />
        <parameter name="catalogueStripPlaceholders" value="true" />
        <classes><class name="com.example.seleniumdemo.custom.catalogue.WorkflowCatalogueGenerator" /></classes>
    </test>
</suite>
