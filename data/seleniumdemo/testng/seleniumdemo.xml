<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="seleniumdemo test suite" parallel="none" verbose="1" thread-count="1">

	<parameter name="browser" value="chrome" />
	<parameter name="headless" value="false" />
	<parameter name="seleniumRobotServerUrl" value="http://localhost:8000" />
	<parameter name="seleniumRobotServerActive" value="true" />
	<!-- seleniumRobotServerToken retire d'ici: vient de la variable d'env SELENIUM_ROBOT_SERVER_TOKEN -->
	<parameter name="testRetryCount" value="0" />
	<parameter name="equipe" value="Selenium Demo" />
	<!-- <parameter name="customReport" value="true" /> -->

	<listeners>
		<listener class-name="com.example.seleniumdemo.reporting.CustomReportListener" />
		<listener class-name="com.example.seleniumdemo.reporting.TeamInfoListener" />
	</listeners>

	<test name="WebForm">
		<classes>
			<class name="com.example.seleniumdemo.tests.WebFormTest" />
		</classes>
	</test>

<!--	<test name="MasterWorkflow">-->
<!--		<classes>-->
<!--			<class name="com.example.seleniumdemo.tests.MasterWorkflowTest" />-->
<!--		</classes>-->
<!--	</test>-->

	<test name="VariableDrivenScenario">
		<classes>
			<class name="com.example.seleniumdemo.tests.VariableDrivenScenarioTest" />
		</classes>
	</test>

	<test name="Documentation">
		<!-- champs a afficher dans le catalogue, dans l'ordre, separes par virgule.
		     valeurs possibles: code, name, method, description, class -->
		<parameter name="catalogueFields" value="code,name,method,description,class" />
		<!-- sheets = 1 seul fichier xlsx, 1 onglet par classe Workflow (nom sans "Workflow").
		     blocks = 1 seul fichier xlsx, 1 seule feuille, 1 bloc de colonnes par classe, empiles verticalement.
		     json = 1 fichier json, 1 objet par classe Workflow ("class"+"workflows").
		     matrix = 1 seul fichier xlsx, 1 ligne par code, classe fusionnee verticalement. -->
		<parameter name="catalogueLayout" value="sheets" />
		<!-- retire les "${xxx}" (placeholders runtime) du champ "name" affiche -->
		<parameter name="catalogueStripPlaceholders" value="true" />
		<classes>
			<class name="com.example.seleniumdemo.tests.WorkflowCatalogueGenerator" />
		</classes>
	</test>

</suite>
